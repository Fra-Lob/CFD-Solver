BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

# Match the existing entity containers: four spaces and visible code blocks.
IndentWidth: 4
ContinuationIndentWidth: 4
NamespaceIndentation: All
AccessModifierOffset: -4
ColumnLimit: 100
BreakBeforeBraces: Attach
InsertBraces: true

# Give every operation and control-flow body its own line.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortEnumsOnASingleLine: false
SeparateDefinitionBlocks: Always

PointerAlignment: Left
ReferenceAlignment: Pointer
SpaceBeforeParens: ControlStatements
BinPackParameters: false
ReflowComments: false
LineEnding: LF

# Keep project headers, standard headers and private helpers in clear groups.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeCategories:
  - Regex: '^<cfd/'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '^"'
    Priority: 3
