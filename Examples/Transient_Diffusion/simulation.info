
#==========================================================#
#                       Simulation                         #
#==========================================================#
name = Transient_Diffusion.vtu
type = scalarTransport
mesh = Box
scalar fields = C1

#==========================================================#
#                        Physics                           #
#==========================================================#
diffusivity = 1.0
density = 1.0

#==========================================================#
#                          Time                            #
#==========================================================#
initial velocity = 0.0, 0.0, 0.0
initial values = 100.0
dt = 0.001
timesteps = 100

#==========================================================#
#                    Solver settings                       #
#==========================================================#
tolerance = 1e-10
maxIterations = 10000

#==========================================================#
#                       Boundary                           #
#==========================================================#
xmin
type  = Dirichlet
value =       0.0

xmax
type  = Dirichlet
value =       0.0

ymin
type  = Neumann
value =     0.0

ymax
type  = Neumann
value =     0.0

zmin
type  = Neumann
value =     0.0

zmax
type  = Neumann
value =     0.0

#==========================================================#
#                         Output                           #
#==========================================================#
directory = results
vtk = true, 50
csv = true, 50
csv start points = (0., 0.5, 0.5)
csv end   points = (2., 0.5, 0.5)
csv resolution   = 100