
#==========================================================#
#                       Simulation                         #
#==========================================================#
name = Steady_Diffusion.vtu
type = scalarTransport
mesh = Box
scalar fields = C1, C2

#==========================================================#
#                        Physics                           #
#==========================================================#
diffusivity = 1.0, 1.0
density = 1.0

#==========================================================#
#                          Time                            #
#==========================================================#
initial velocity = 0.0, 0.0, 0.0
initial values = 300.0, 150.0
dt = 1.0
timesteps = 0

#==========================================================#
#                    Solver settings                       #
#==========================================================#
tolerance = 1e-10
maxIterations = 10000

#==========================================================#
#                       Boundary                           #
#==========================================================#
xmin
type  = Dirichlet, Neumann
value =     100.0,     0.0

xmax
type  = Dirichlet, Dirichlet
value =       0.0,      10.0

ymin
type  = Neumann, Neumann
value =     0.0,     0.0

ymax
type  = Neumann, Neumann
value =     0.0,     0.0

zmin
type  = Neumann, Dirichlet
value =     0.0,       2.0

zmax
type  = Neumann, Neumann
value =     0.0,     0.0

#==========================================================#
#                         Output                           #
#==========================================================#
directory = results
vtk = true, 1
csv = true, 1
csv start points = (0., 0.5, 0.5), (1., 0., 0.5)
csv end   points = (2., 0.5, 0.5), (1., 1., 0.5)
csv resolution   = 100, 10